# Copiar para /etc/guapu/app.env na VPS e preencher fora do Git.
NODE_ENV=production
PORT=3212
HOSTNAME=0.0.0.0
GUAPU_SURFACE=app
NEXT_PUBLIC_API_URL=/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_API_KEY=
# Modelo validado na VPS; o código mantém fallback controlado para indisponibilidade temporária.
# Modelo primário validado e estável; fallbacks controlados permanecem no código.
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Provedores opcionais para a cadeia de geração: OpenAI -> Moonshot -> Gemini.
# Preencher as chaves somente em /etc/guapu/app.env; nunca versionar segredos.
CHAT_PRIMARY_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_CHAT_MODEL=kimi-k3
MOONSHOT_API_KEY=
RAG_MATCH_THRESHOLD=0.35
RAG_MATCH_COUNT=5
RAG_TABLE_NAME=documents
ACTIVE_PLAN_SOURCE=administrativo__plano_ensino_INT55224__plano__ufsc__2026_2.pdf
RAG_REFERENCES_ENABLED=true
ADMIN_DASHBOARD_USER=
ADMIN_DASHBOARD_PASSWORD=
CRON_SECRET=
ENABLE_MONITOR_CRON=false

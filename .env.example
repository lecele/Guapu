# Frontend / API
NEXT_PUBLIC_API_URL=/api

# Painel administrativo (obrigatório em produção; protege conversas e métricas)
ADMIN_DASHBOARD_USER=defina_um_usuario_admin
ADMIN_DASHBOARD_PASSWORD=defina_uma_senha_longa_e_exclusiva

# Google AI
# Modelo primário validado e estável; fallbacks controlados permanecem no código.
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=preencha_no_ambiente_local_ou_na_vercel

# Supabase
SUPABASE_SERVICE_ROLE_KEY=preencha_somente_no_servidor
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_DIRECT_INGESTION=false
SUPABASE_KEY=preencha_com_a_chave_anon_para_uso_local
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres

# RAG
RAG_MATCH_THRESHOLD=0.35
RAG_MATCH_COUNT=5
RAG_TABLE_NAME=documents
ACTIVE_PLAN_SOURCE=administrativo__plano_ensino_INT55224__plano__ufsc__2026_2.pdf
RAG_REFERENCES_ENABLED=true

# Google Drive
GOOGLE_SERVICE_ACCOUNT_JSON=cole_o_json_completo_apenas_no_ambiente_seguro
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json
DRIVE_FOLDER_ID=preencha_no_ambiente_seguro
DRIVE_WEBHOOK_SECRET=preencha_no_ambiente_seguro
DRIVE_CHANNEL_ID=preencha_no_ambiente_seguro
DRIVE_SYNC_MAX_FILES=10

# Aplicação Python / ingestão
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=150
INGESTION_BATCH_SIZE=20
